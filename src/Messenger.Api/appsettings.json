{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Cors": {
    "AllowedOrigins": []
  },
  
  "ConnectionStrings": {
    "MessengerDb": "Host=localhost;Port=5432;Database=enterprise_messenger;Username=postgres;Password=123456"
  },
  "FileStorage": {
  "RootPath": "D:\\Projects\\EnterpriseMessenger\\storage"
},
"Auth": {
  "AllowLocalLogin": false
},
"Keycloak": {
  "Authority": "",
  "MetadataAddress": "",
  "Audience": "messenger-api",
  "ClientId": "messenger-web",
  "AdminRole": "messenger-admin",
  "RequireHttpsMetadata": true
},
"Jwt": {
  "Issuer": "EnterpriseMessenger",
  "Audience": "EnterpriseMessengerClients",
  "SecretKey": ""
},
"Redis": {
  "ConnectionString": "localhost:6379"
},
"Minio": {
  "Endpoint": "minio:9000",
  "PublicEndpoint": "localhost:9000",
  "AccessKey": "minioadmin",
  "SecretKey": "minioadmin_password",
  "BucketName": "messenger-files",
  "UseSsl": false
},
"FileUpload": {
  "MaxFileSizeBytes": 52428800,
  "AllowedContentTypes": [
    "image/png",
    "image/jpeg",
    "image/webp",
    "application/pdf",
    "text/plain",
    "application/zip"
  ]
},
"OpenSearch": {
  "Url": "http://localhost:9200",
  "MessagesIndex": "messenger-messages"
}

}
