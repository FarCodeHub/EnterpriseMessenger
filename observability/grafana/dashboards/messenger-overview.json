    {
      "id": 8,
      "type": "timeseries",
      "title": "Outbox: write to publish delay",
      "description": "Search indexing and notifications run from these events. A growing delay means the publisher or RabbitMQ is behind.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 12,
        "y": 33,
        "w": 12,
        "h": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
