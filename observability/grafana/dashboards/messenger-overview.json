    {
      "id": 11,
      "type": "timeseries",
      "title": "Database connections",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 49,
        "w": 12,
        "h": 8
      },
      "description": "Npgsql pool: connections in use and idle, and the pool maximum. Hitting the maximum makes requests wait.",
