{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Launch Messenger.Api (HTTPS)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build Messenger.Api",
      "program": "${workspaceFolder}/src/Messenger.Api/bin/Debug/net10.0/Messenger.Api.dll",
      "args": [],
      "cwd": "${workspaceFolder}/src/Messenger.Api",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "ASPNETCORE_URLS": "https://localhost:7058;http://localhost:5006"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)"
      }
    },
    {
      "name": "Attach to .NET Process",
      "type": "coreclr",
      "request": "attach"
    }
  ]
}