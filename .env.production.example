# Copy this file to .env.production on the server and fill in real values.
# Never commit .env.production — it is ignored by git.

POSTGRES_DB=enterprise_messenger
POSTGRES_USER=messenger
POSTGRES_PASSWORD=CHANGE_ME

RABBITMQ_USER=messenger
RABBITMQ_PASSWORD=CHANGE_ME

MINIO_ROOT_USER=CHANGE_ME
MINIO_ROOT_PASSWORD=CHANGE_ME
MINIO_BUCKET_NAME=messenger-files
MINIO_PUBLIC_ENDPOINT=localhost:9000

ASPNETCORE_ENVIRONMENT=Production

# At least 32 random characters, e.g. `openssl rand -base64 48`
JWT_SECRET_KEY=CHANGE_ME

# Browser origin allowed to call the API directly (e.g. https://chat.example.com).
# Leave empty when the web app is served by the bundled nginx (same origin).
CORS_ALLOWED_ORIGIN=

# Organization sign-in (Keycloak). Public URL of Keycloak behind the bundled nginx, without a trailing slash.
KEYCLOAK_PUBLIC_URL=https://chat.example.com/sso
KEYCLOAK_DB_PASSWORD=CHANGE_ME
KEYCLOAK_ADMIN_USERNAME=CHANGE_ME
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME

# The messenger admin. Create a Keycloak/AD user with the same user name to sign in as this admin.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_DISPLAY_NAME=System Admin

OPENSEARCH_INITIAL_ADMIN_PASSWORD=CHANGE_ME

# Grafana (http://127.0.0.1:3000): dashboards for the API's metrics and traces.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
